# ==============================================================================
# TAGLUXE 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN:
# 1. Sao chép file này thành '.env' trong thư mục gốc: cp .env.example .env
# 2. Điền các giá trị thực tế tương ứng với môi trường chạy (Development / Production).
# 3. TUYỆT ĐỐI KHÔNG commit file '.env' thật chứa mật khẩu và khóa API lên Git.
# ==============================================================================

# --- Môi trường chạy Flask ---
# Giá trị: 'development' (khi code máy local) hoặc 'production' (khi chạy máy chủ live)
FLASK_ENV=development

# --- Khóa bảo mật phiên làm việc (Session Secret Key) ---
# Tạo chuỗi ngẫu nhiên bảo mật cao (VD bằng lệnh: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# --- Tài khoản quản trị Trang Quản Trị (Admin Panel) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Khuyến nghị Production: Dùng ADMIN_PASSWORD_HASH thay vì mật khẩu thô
# Tạo hash bằng: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('mat_khau_cua_ban'))"
ADMIN_PASSWORD_HASH=

# --- Cơ sở dữ liệu (Database Connection) ---
# Môi trường Local SQLite: sqlite:///tagluxe.db
# Môi trường Production PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/tagluxe_db
DATABASE_URL=
# Persistent images on Supabase (backend only; never expose the secret in HTML/JS).
MEDIA_STORAGE=local
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tagluxe-media
# Optional: restore missing quotes from the existing Google Sheets on admin login.
# Requires the updated Apps Script in integrations/google_sheets/.
GOOGLE_SHEET_RESTORE_ON_LOGIN=true

# --- Tên miền gốc Website (Canonical URL & SEO) ---
SITE_URL=https://tagluxe.onrender.com

# --- Tích hợp Google Sheets (Đồng bộ Báo giá thời gian thực) ---
# URL Web App từ Google Apps Script
GOOGLE_SHEET_WEBHOOK_URL=
# Secret Token bảo mật webhook (trùng khớp với WEBHOOK_SECRET cấu hình trong script)
GOOGLE_SHEET_SECRET=

# --- Email thông báo Quản trị viên ---
ADMIN_NOTIFICATION_EMAIL=admin@tagluxe.vn

# --- Tiếp thị & Phân tích (Marketing & Analytics) ---
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_SITE_VERIFICATION=
FACEBOOK_PIXEL_ID=
